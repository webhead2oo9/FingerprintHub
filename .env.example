# FingerprintHub environment.  Copy to .env and fill in.

# Postgres DSN. Local dev (docker compose): port 54330.
# Production: native postgresql.service, e.g.
#   postgresql://fingerprinthub:<password>@127.0.0.1:5432/fingerprinthub
FINGERPRINTHUB_DATABASE_URL=postgresql://fingerprinthub:fingerprinthub_dev@localhost:54330/fingerprinthub_dev

# Field-encryption keys (encrypts reason/source_url at rest). Generate with:
#   venv/bin/python tools/generate_field_key.py --key-id v1
# These are INDEPENDENT from Nexarion's keys (separate blast radius).
FINGERPRINTHUB_FIELD_ENCRYPTION_KEYS=v1:REPLACE_WITH_BASE64_32_BYTE_KEY
FINGERPRINTHUB_FIELD_ENCRYPTION_ACTIVE_KEY_ID=v1

# Bind address / port (localhost-only by default).
FINGERPRINTHUB_HOST=127.0.0.1
FINGERPRINTHUB_PORT=58751

# Optional knobs (defaults shown).
# FINGERPRINTHUB_RATE_LIMIT=300
# FINGERPRINTHUB_AUTO_HIDE_FLAG_THRESHOLD=2
# FINGERPRINTHUB_MAX_SYNC_LIMIT=500
# FINGERPRINTHUB_DEFAULT_SYNC_LIMIT=200
# FINGERPRINTHUB_MAX_LIST_LIMIT=200
# FINGERPRINTHUB_LOG_LEVEL=INFO
